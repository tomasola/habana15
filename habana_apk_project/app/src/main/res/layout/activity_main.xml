<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050a19">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#050a19" />

    <ProgressBar
        android:id="@+id/loadingSpinner"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="visible" />

    <LinearLayout
        android:id="@+id/errorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0b1120"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HABANA TABLET"
            android:textColor="#00f3ff"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/errorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Conectando con el servidor..."
            android:textColor="#94a3b8"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#00f3ff"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:text="Reconectar"
            android:textColor="#000000"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnToggleUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#1e293b"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:text="Cambiar a WiFi Local (LAN)"
            android:textColor="#00f3ff" />

        <Button
            android:id="@+id/btnEditUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#0f172a"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:text="⚙️ Modificar Dirección / URL"
            android:textColor="#94a3b8" />
    </LinearLayout>

</FrameLayout>
